/* Base Reset & Variables */
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    background-color: #020304;
    color: #8c9b9d;
    font-family: 'Courier New', Courier, monospace;
    overflow: hidden; /* Stops scrolling */
    touch-action: none; /* Stops pinch-to-zoom on mobile */
    user-select: none;
    position: relative;
}

/* Holographic Scanline Effect */
body::after {
    content: " "; 
    display: block; 
    position: absolute; 
    top: 0; left: 0; bottom: 0; right: 0;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
    z-index: 5; 
    background-size: 100% 2px, 3px 100%; 
    pointer-events: none; /* Lets you tap through the scanlines */
}

/* HUD Overlay Styling */
#ui-layer {
    position: absolute; 
    top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none; /* Lets taps pass through to the canvas */
    display: flex; 
    flex-direction: column; 
    justify-content: space-between;
    padding: 20px; 
    z-index: 10;
}

.header-info {
    display: flex; justify-content: space-between; 
    font-size: 1rem; font-weight: bold;
    color: #00d4ff; text-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
}

.resource-block { text-align: right; }

#controls-container { display: flex; flex-direction: column; gap: 10px; }

#tech-panel {
    pointer-events: auto; background: rgba(5, 10, 15, 0.95); border: 1px solid #00d4ff;
    padding: 15px; font-size: 0.8rem; color: #00d4ff; text-align: center;
    box-shadow: 0 0 15px rgba(0, 212, 255, 0.2);
}

.button-row { display: flex; gap: 10px; pointer-events: auto; }

button {
    flex: 1; padding: 15px; background: rgba(5, 10, 15, 0.8); border: 1px solid #4a6b8c;
    color: #4a6b8c; font-family: 'Courier New', Courier, monospace; font-size: 0.9rem;
    font-weight: bold; cursor: pointer; text-transform: uppercase; transition: 0.2s;
}

button:active { transform: scale(0.98); }
#action-btn { border-color: #d32f2f; color: #d32f2f; }
#tech-btn { border-color: #00d4ff; color: #00d4ff; }

/* Canvas Styling */
#gameCanvas { display: block; width: 100vw; height: 100vh; position: relative; z-index: 1; }

/* End Game Screen */
#game-over {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(2, 3, 4, 0.95); display: flex; flex-direction: column;
    align-items: center; justify-content: center; z-index: 20; pointer-events: auto;
}

#game-over h1 { font-size: 2.5rem; color: #00d4ff; margin-bottom: 10px; text-align: center; text-shadow: 0 0 20px rgba(0, 212, 255, 0.6);}
#game-over p { color: #8c9b9d; margin-bottom: 30px; letter-spacing: 0.1rem; text-align: center;}
#restart-btn { border-color: #00d4ff; color: #00d4ff; padding: 15px 30px; box-shadow: 0 0 10px rgba(0, 212, 255, 0.2); }

.hidden { display: none !important; }