* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    background-color: #030507;
    color: #8c9b9d;
    font-family: 'Courier New', Courier, monospace;
    overflow: hidden; 
    touch-action: none; 
    user-select: none;
}

#ui-layer {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none; 
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
    z-index: 10;
}

.header-info {
    display: flex;
    justify-content: space-between;
    font-size: 1rem;
    font-weight: bold;
    color: #d4af37;
    text-shadow: 0 0 5px rgba(212, 175, 55, 0.5);
}

.resource-block { text-align: right; }

#controls-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

#tech-panel {
    pointer-events: auto;
    background: rgba(10, 15, 20, 0.9);
    border: 1px solid #00d4ff;
    padding: 10px;
    font-size: 0.8rem;
    color: #00d4ff;
    text-align: center;
}

.button-row {
    display: flex;
    gap: 10px;
    pointer-events: auto;
}

button {
    flex: 1;
    padding: 15px;
    background: rgba(5, 10, 15, 0.8);
    border: 1px solid #4a6b8c;
    color: #4a6b8c;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    font-weight: bold;
    cursor: pointer;
    text-transform: uppercase;
}

button:active { background: #4a6b8c; color: #000; }
#action-btn { border-color: #d32f2f; color: #d32f2f; }
#tech-btn { border-color: #00d4ff; color: #00d4ff; }

#gameCanvas { display: block; width: 100vw; height: 100vh; }

#game-over {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(3, 5, 7, 0.95); display: flex; flex-direction: column;
    align-items: center; justify-content: center; z-index: 20; pointer-events: auto;
}

#game-over h1 { font-size: 2rem; color: #d4af37; margin-bottom: 10px; text-align: center;}
#game-over p { color: #8c9b9d; margin-bottom: 30px; }
#restart-btn { border-color: #d4af37; color: #d4af37; padding: 15px 30px; }

.hidden { display: none !important; }
